rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: analyses
    // Fields:
    //   - uid: string (required) - Owner's user ID
    //   - subject: string (required)
    //   - institution: string
    //   - academicContext: string
    //   - metadataConfidence: number
    //   - inferredSyllabus: string
    //   - questions: list (required)
    //   - rawQuestions: list
    //   - summary: string
    //   - createdAt: timestamp (required)
    //
    // Collection: logs
    // Fields:
    //   - uid: string (required)
    //   - action: string (required)
    //   - details: string
    //   - timestamp: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "jadhavabhay2005@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidAnalysis(data) {
      return data.keys().hasAll(['uid', 'subject', 'questions', 'createdAt']) &&
             data.uid is string &&
             data.subject is string && data.subject.size() < 200 &&
             data.questions is list && data.questions.size() < 1000 &&
             data.createdAt is timestamp;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['uid', 'action', 'timestamp']) &&
             data.uid is string &&
             data.action is string && data.action.size() < 100 &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /analyses/{analysisId} {
      allow read: if isDocOwner() || isAdmin();
      allow create: if isAuthenticated() && 
                      request.resource.data.uid == request.auth.uid &&
                      isValidAnalysis(request.resource.data);
      allow update: if isDocOwner() && 
                      request.resource.data.uid == resource.data.uid &&
                      isValidAnalysis(request.resource.data);
      allow delete: if isDocOwner() || isAdmin();
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
                      request.resource.data.uid == request.auth.uid &&
                      isValidLog(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
